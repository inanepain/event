{
    "name": "inanepain/event",
    "description": "PSR-14 implementation: event dispatcher.",
    "type": "library",
    "license": "Unlicense",
    "homepage": "https://github.com/inanepain/event",
    "readme": "README.adoc",
    "authors": [
        {
            "name": "Philip Michael Raab",
            "email": "philip@cathedral.co.za",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "philip@cathedral.co.za",
        "issues": "https://github.com/inanepain"
    },
    "keywords": [
        "inane",
        "event",
        "dispatcher",
        "listener"
    ],
    "autoload": {
        "psr-4": {
            "Inane\\Event\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inane\\Event\\Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "discard-changes": true,
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.5",
        "psr/event-dispatcher": ">=1.0",
        "fig/event-dispatcher-util": ">=1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "*"
    },
    "scripts": {
        "mk-doc-dir": [
            "mkdir -p doc/{changelog,readme}",
            "mkdir -p doc/changelog/release",
            "mkdir -p doc/readme/part",
            "touch doc/{changelog,readme}/index.adoc",
            "touch doc/changelog/release/0.0.0.adoc",
            "touch doc/readme/part/install.adoc"
        ],
        "build": [
            "echo build: doc: db",
            "@build-changelog",
            "@build-readme",
            "echo doc: db: built"
        ],
        "build-changelog": [
            "echo building: changelog...",
            "asciidoctor-reducer -o CHANGELOG.adoc doc/changelog/index.adoc"
        ],
        "build-readme": [
            "echo building: readme...",
            "asciidoctor-reducer -o README.adoc doc/readme/index.adoc"
        ]
    }
}
